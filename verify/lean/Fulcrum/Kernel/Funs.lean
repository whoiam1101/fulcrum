def exp.log2_wide (a : Std.U64) (f : Std.U32) : Result Std.I128 := do
  let i ← lift (core.num.U64.leading_zeros a)
  let e ← 63#u32 - i
  let u ←
    if e > tables.exp.FRAC
    then do
         let i1 ← e - tables.exp.FRAC
         a >>> i1
    else do
         let i1 ← tables.exp.FRAC - e
         a <<< i1
  let i1 ← tables.exp.FRAC - tables.exp.STEPS
  let i2 ← u >>> i1
  let i3 ← 1#u64 <<< tables.exp.STEPS
  let k ← i2 - i3
  let i4 ← k <<< i1
  let i5 ← exp.ONE
  let c ← i5 + i4
  let i6 ← u + c
  let d ← lift (UScalar.cast .U128 i6)
  let i7 ← u - c
  let r ← lift (UScalar.cast .U128 i7)
  let i8 ← r <<< 64#i32
  let high ← i8 / d
  let i9 ← i8 % d
  let i10 ← i9 <<< 64#i32
  let low ← i10 / d
  let i11 ← high <<< 64#i32
  let s ← lift (i11 ||| low)
  let z ← exp.mul_hi s s
  let g ← core.num.U128.MAX / 13#u128
  let i12 ← core.num.U128.MAX / 11#u128
  let i13 ← exp.mul_hi z g
  let g1 ← i12 + i13
  let i14 ← core.num.U128.MAX / 9#u128
  let i15 ← exp.mul_hi z g1
  let g2 ← i14 + i15
  let i16 ← core.num.U128.MAX / 7#u128
  let i17 ← exp.mul_hi z g2
  let g3 ← i16 + i17
  let i18 ← core.num.U128.MAX / 5#u128
  let i19 ← exp.mul_hi z g3
  let g4 ← i18 + i19
  let i20 ← core.num.U128.MAX / 3#u128
  let i21 ← exp.mul_hi z g4
  let g5 ← i20 + i21
  let i22 ← exp.mul_hi z g5
  let i23 ← exp.mul_hi s i22
  let atanh ← s + i23
  let i24 ← lift (UScalar.cast .Usize k)
  let i25 ← Array.index_usize tables.exp.LOG2_WIDE i24
  let i26 ← exp.mul_hi atanh tables.exp.TWO_LOG2_E_WIDE
  let l ← i25 + i26
  let i27 ← lift (UScalar.hcast .I128 e)
  let i28 ← lift (UScalar.hcast .I128 f)
  let i29 ← i27 - i28
  let i30 ← i29 <<< exp.W_FRAC
  let i31 ← tables.exp.WIDE_FRAC - exp.W_FRAC
  let i32 ← l >>> i31
  let i33 ← lift (UScalar.hcast .I128 i32)
  i30 + i33

