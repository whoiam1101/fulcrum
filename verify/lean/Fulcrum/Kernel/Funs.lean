/-- [fulcrum::exp::exp_unit]:
    Source: 'src/exp.rs', lines 106:0-113:1 -/
def exp.exp_unit (k : Std.U64) (y : Std.U64) : Result Std.U128 := do
  let i ← lift (UScalar.cast .Usize k)
  let t ← Array.index_usize tables.exp.EXP2 i
  if y = 0#u64
  then ok t
  else
    let i1 ← exp.expm1 y
    let e ← lift (UScalar.cast .U128 i1)
    let i2 ← t >>> 64#i32
    let i3 ← i2 * e
    let i4 ← exp.EXPM1_FRAC - 64#u32
    let i5 ← i3 >>> i4
    let i6 ← t + i5
    let i7 ← lift (UScalar.cast .U64 t)
    let i8 ← lift (UScalar.cast .U128 i7)
    let i9 ← i8 * e
    let i10 ← i9 >>> exp.EXPM1_FRAC
    i6 + i10

/-- [fulcrum::exp::exp2_unit]:
    Source: 'src/exp.rs', lines 118:0-121:1 -/
def exp.exp2_unit
  (k : Std.U64) (b : Std.U64) (f : Std.U32) : Result Std.U128 := do
  let i ← lift (UScalar.cast .U128 b)
  let i1 ← i * tables.exp.LN_2
  let i2 ← f + tables.exp.LN_2_FRAC
  let i3 ← i2 - exp.EXPM1_FRAC
  let i4 ← i1 >>> i3
  let y ← lift (UScalar.cast .U64 i4)
  exp.exp_unit k y

