/-- [fulcrum::exp::log2_unit]:
    Source: 'src/exp.rs', lines 40:0-48:1 -/
def exp.log2_unit (u : Std.U64) : Result Std.U64 := do
  let i ← tables.exp.FRAC - tables.exp.STEPS
  let i1 ← u >>> i
  let i2 ← 1#u64 <<< tables.exp.STEPS
  let k ← i1 - i2
  let i3 ← k <<< i
  let i4 ← exp.ONE
  let c ← i4 + i3
  let i5 ← u - c
  let i6 ← lift (UScalar.cast .U128 i5)
  let i7 ← i6 <<< tables.exp.FRAC
  let i8 ← u + c
  let i9 ← lift (UScalar.cast .U128 i8)
  let s ← i7 / i9
  let s1 ← lift (UScalar.cast .U64 s)
  let z ← exp.mul s1 s1
  let i10 ← i4 / 3#u64
  let i11 ← i4 / 5#u64
  let i12 ← exp.mul z i11
  let i13 ← i10 + i12
  let i14 ← exp.mul z i13
  let i15 ← exp.mul s1 i14
  let series ← s1 + i15
  let i16 ← lift (UScalar.cast .Usize k)
  let i17 ← Array.index_usize tables.exp.LOG2 i16
  let i18 ← exp.mul series tables.exp.TWO_LOG2_E
  i17 + i18

/-- [fulcrum::exp::split_log2]:
    Source: 'src/exp.rs', lines 53:0-57:1 -/
def exp.split_log2 (raw : Std.I64) : Result (Std.I64 × Std.U64) := do
  let a ← lift (IScalar.hcast .U64 raw)
  let i ← lift (core.num.U64.leading_zeros a)
  let e ← 63#u32 - i
  let i1 ← lift (UScalar.hcast .I64 e)
  let i2 ← tables.exp.FRAC - e
  let i3 ← a <<< i2
  let i4 ← exp.log2_unit i3
  ok (i1, i4)

/-- [fulcrum::kernel::shr_round]:
    Source: 'src/kernel.rs', lines 39:0-47:1 -/
def kernel.shr_round (n : Std.I128) (s : Std.U32) : Result Std.I128 := do
  if s = 0#u32
  then ok n
  else
    if s >= 128#u32
    then ok 0#i128
    else
      let i ← n >>> s
      let i1 ← s - 1#u32
      let i2 ← n >>> i1
      let i3 ← lift (i2 &&& 1#i128)
      i + i3

/-- [fulcrum::exp::log2]:
    Source: 'src/exp.rs', lines 62:0-66:1 -/
def exp.log2 (raw : Std.I64) (f : Std.U32) : Result Std.I64 := do
  let (e, l) ← exp.split_log2 raw
  let i ← lift (UScalar.hcast .I128 l)
  let i1 ← tables.exp.FRAC - f
  let i2 ← kernel.shr_round i i1
  let r ← lift (IScalar.cast .I64 i2)
  let i3 ← lift (UScalar.hcast .I64 f)
  let i4 ← e - i3
  let i5 ← i4 <<< f
  i5 + r

