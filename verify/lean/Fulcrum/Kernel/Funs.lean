def exp.exp2_wide (w : Std.I128) (f : Std.U32) : Result Std.I128 := do
  let i ← w >>> exp.W_FRAC
  let n ← lift (IScalar.cast .I64 i)
  let i1 ← lift (UScalar.hcast .I64 f)
  if n >= i1
  then exp.overflow f
  else
    let i2 ← lift (IScalar.hcast .U128 w)
    let i3 ← 1#u128 <<< exp.W_FRAC
    let i4 ← i3 - 1#u128
    let t ← lift (i2 &&& i4)
    let rest ← exp.W_FRAC - tables.exp.STEPS
    let i5 ← t >>> rest
    let k ← lift (UScalar.cast .U64 i5)
    let i6 ← 1#u128 <<< rest
    let i7 ← i6 - 1#u128
    let r ← lift (t &&& i7)
    let i8 ← exp.W_FRAC - exp.EXPM1_FRAC
    let i9 ← r >>> i8
    let i10 ← tables.exp.LN_2_FRAC - 64#u32
    let i11 ← tables.exp.LN_2 >>> i10
    let i12 ← i9 * i11
    let i13 ← i12 >>> 64#i32
    let y ← lift (UScalar.cast .U64 i13)
    let i14 ← exp.exp_unit k y
    exp.round_mantissa i14 n f

