def exp.pow_magnitude
  (a : Std.U64) (f : Std.U32) (y : Std.I64) (fy : Std.U32) :
  Result Std.I128
  := do
  let l ← exp.log2_wide a f
  let lm ← core.num.I128.unsigned_abs l
  let i ← core.num.I64.unsigned_abs y
  let ym ← lift (UScalar.cast .U128 i)
  let i1 ← lm >>> 64#i32
  let high ← ym * i1
  let i2 ← 62#u32 + fy
  let i3 ← 1#u128 <<< i2
  if high >= i3
  then if (l < 0#i128) != (y < 0#i64)
       then ok 0#i128
       else exp.overflow f
  else
    let i4 ← 64#u32 - fy
    let i5 ← high <<< i4
    let i6 ← lift (UScalar.cast .U64 lm)
    let i7 ← lift (UScalar.cast .U128 i6)
    let i8 ← ym * i7
    let i9 ← i8 >>> fy
    let i10 ← i5 + i9
    let m ← lift (UScalar.hcast .I128 i10)
    let m1 ← if (l < 0#i128) != (y < 0#i64)
               then -. m
               else ok m
    exp.exp2_wide m1 f

