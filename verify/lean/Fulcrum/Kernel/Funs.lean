def exp.round_mantissa
  (m : Std.U128) (n : Std.I64) (f : Std.U32) : Result Std.I128 := do
  let i ← lift (UScalar.hcast .I64 tables.exp.EXP2_FRAC)
  let i1 ← lift (UScalar.hcast .I64 f)
  let i2 ← i - i1
  let s ← i2 - n
  let s1 ← if s > 128#i64
             then ok 128#u32
             else ok (IScalar.hcast .U32 s)
  let i3 ← lift (UScalar.hcast .I128 m)
  kernel.shr_round i3 s1

