def exp.exp (raw : Std.I64) (f : Std.U32) : Result Std.I128 := do
  let i ← lift (UScalar.hcast .I64 f)
  let i1 ← i <<< f
  if raw >= i1
  then exp.overflow f
  else
    let i2 ← lift (UScalar.hcast .I64 f)
    let i3 ← 2#i64 * i2
    let i4 ← i3 <<< f
    let i5 ← -. i4
    if raw <= i5
    then ok 0#i128
    else
      let raw1 ← lift (IScalar.cast .I128 raw)
      let i6 ← lift (UScalar.hcast .I128 tables.exp.TWO_LOG2_E)
      let i7 ← raw1 * i6
      let i8 ← f + tables.exp.FRAC
      let i9 ← i8 + 1#u32
      let i10 ← i9 - tables.exp.STEPS
      let j ← i7 >>> i10
      let i11 ← exp.REDUCED_FRAC
      let i12 ← i11 - f
      let i13 ← raw1 <<< i12
      let i14 ← lift (UScalar.hcast .I128 tables.exp.LN_2)
      let i15 ← j * i14
      let y ← i13 - i15
      let (j1, y1) ←
        if y < 0#i128
        then
          do
          let j2 ← j - 1#i128
          let i16 ← lift (UScalar.hcast .I128 tables.exp.LN_2)
          let y2 ← y + i16
          ok (j2, y2)
        else
          do
          let i16 ← lift (UScalar.hcast .I128 tables.exp.LN_2)
          if y >= i16
          then
            let j2 ← j + 1#i128
            let i17 ← lift (UScalar.hcast .I128 tables.exp.LN_2)
            let y2 ← y - i17
            ok (j2, y2)
          else ok (j, y)
      let i16 ← j1 >>> tables.exp.STEPS
      let n ← lift (IScalar.cast .I64 i16)
      let i17 ← lift (UScalar.hcast .I64 f)
      let i18 ← i17 - 1#i64
      if n >= i18
      then exp.overflow f
      else
        let i19 ← 1#i128 <<< tables.exp.STEPS
        let i20 ← i19 - 1#i128
        let i21 ← lift (j1 &&& i20)
        let k ← lift (IScalar.hcast .U64 i21)
        let i22 ← i11 - exp.EXPM1_FRAC
        let i23 ← y1 >>> i22
        let i24 ← lift (IScalar.hcast .U64 i23)
        let m ← exp.exp_unit k i24
        exp.round_mantissa m n f

