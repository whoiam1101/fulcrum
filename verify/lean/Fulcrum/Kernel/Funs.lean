def exp.pow
  (raw : Std.I64) (f : Std.U32) (y : Std.I64) (fy : Std.U32) :
  Result (Option Std.I128)
  := do
  if y = 0#i64
  then let i ← 1#i128 <<< f
       ok (some i)
  else
    if raw = 0#i64
    then
      if y > 0#i64
      then ok (some 0#i128)
      else let i ← exp.overflow f
           ok (some i)
    else
      let i ← core.num.I64.unsigned_abs raw
      let m ← exp.pow_magnitude i f y fy
      if raw > 0#i64
      then ok (some m)
      else
        if fy > 0#u32
        then
          let i1 ← 1#i64 <<< fy
          let i2 ← i1 - 1#i64
          let i3 ← lift (y &&& i2)
          if i3 != 0#i64
          then ok none
          else
            let i4 ← y >>> fy
            let i5 ← lift (i4 &&& 1#i64)
            if i5 = 1#i64
            then let m1 ← -. m
                 ok (some m1)
            else ok (some m)
        else
          let i1 ← y >>> fy
          let i2 ← lift (i1 &&& 1#i64)
          if i2 = 1#i64
          then let m1 ← -. m
               ok (some m1)
          else ok (some m)

