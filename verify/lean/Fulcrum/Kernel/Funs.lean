    Source: 'src/exp.rs', lines 146:0-159:1 -/
def exp.exp2 (raw : Std.I64) (f : Std.U32) : Result Std.I128 := do
  let n ← raw >>> f
  let i ← lift (UScalar.hcast .I64 f)
  let i1 ← i - 1#i64
  if n >= i1
  then exp.overflow f
  else
    let i2 ← lift (IScalar.hcast .U64 raw)
    let i3 ← 1#u64 <<< f
    let i4 ← i3 - 1#u64
    let t ← lift (i2 &&& i4)
    let m ←
      if f <= tables.exp.STEPS
      then
        do
        let i5 ← tables.exp.STEPS - f
        let i6 ← t <<< i5
        exp.exp2_unit i6 0#u64 f
      else
        do
        let rest ← f - tables.exp.STEPS
        let i5 ← t >>> rest
        let i6 ← 1#u64 <<< rest
        let i7 ← i6 - 1#u64
        let i8 ← lift (t &&& i7)
        exp.exp2_unit i5 i8 f
    exp.round_mantissa m n f

