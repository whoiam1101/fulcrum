  let i ← lift (UScalar.hcast .I64 f)
  let i1 ← e - i
  let i2 ← lift (IScalar.cast .I128 i1)
  let i3 ← lift (UScalar.hcast .I128 tables.exp.LN_2)
  let whole ← i2 * i3
  let i4 ← lift (UScalar.cast .U128 l)
  let i5 ← tables.exp.LN_2_FRAC - 64#u32
  let i6 ← tables.exp.LN_2 >>> i5
  let i7 ← i4 * i6
  let i8 ← tables.exp.FRAC + 64#u32
  let i9 ← i8 - tables.exp.LN_2_FRAC
  let i10 ← i7 >>> i9
  let part ← lift (UScalar.hcast .I128 i10)
  let i11 ← whole + part
  let i12 ← tables.exp.LN_2_FRAC - f
  let i13 ← kernel.shr_round i11 i12
